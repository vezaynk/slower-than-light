{
  "name": "@stl/totallynotftl",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/archive.ts",
    "./totallynotftl.xml": "./totallynotftl.xml",
    "./totallynotftl.dat": "./totallynotftl.dat"
  },
  "scripts": {
    "generate": "node --experimental-strip-types src/generate.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts",
