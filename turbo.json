{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@stl/game#build": {
      "dependsOn": ["@stl/campaign#generate", "@stl/totallynotftl#generate", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@stl/campaign#generate": {
      "dependsOn": ["^typecheck"],
      "outputs": ["base.xml"],
      "inputs": ["package.json", "src/**"]
    },
    "@stl/totallynotftl#generate": {
      "dependsOn": ["^typecheck"],
      "outputs": ["totallynotftl.xml", "totallynotftl.dat", "totallynotftl.hyperspace.xml"],
      "inputs": ["package.json", "src/**"]
    },
    "@stl/totallynotftl#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "package.json",
        "src/**",
        "totallynotftl.xml",
        "totallynotftl.dat",
        "totallynotftl.hyperspace.xml"
      ]
    },
    "@stl/campaign#test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["package.json", "src/**", "base.xml"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "test": {},
    "lint": {}
  }
}
