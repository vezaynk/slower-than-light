    "@tanstack/react-start": "^1.168.60",
    "@vitejs/plugin-react": "^5.2.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.510.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
