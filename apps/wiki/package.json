{
  "name": "@stl/wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8090 --strictPort",
    "predev": "node --experimental-strip-types src/build.ts",
    "parity": "node --experimental-strip-types src/build.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/parity.test.ts",
    "lint": "cd ../.. && ./node_modules/.bin/eslint apps/wiki"
  },
  "dependencies": {
    "@stl/wiki-dump": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  }
}
