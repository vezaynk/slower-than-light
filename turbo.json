{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@stl/wiki#build": {
      "dependsOn": ["parity", "^build"],
      "outputs": ["dist/**"]
    },
    "@stl/game#build": {
      "dependsOn": ["@stl/totallynotftl#generate", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "parity": {
      "outputs": ["public/parity.json"],
      "inputs": ["src/**", "../../apps/game/src/**", "../../packages/wiki-dump/**"]
    },
    "@stl/campaign#generate": {
      "outputs": ["base.xml"],
      "inputs": [
        "package.json",
        "src/xml.ts",
        "src/generate.ts",
        "../../apps/game/src/game/**/*.ts",
        "!../../apps/game/src/game/**/*.test.ts",
        "../../packages/pack/src/**",
        "../../packages/pack/package.json"
      ]
    },
    "@stl/totallynotftl#generate": {
      "outputs": ["totallynotftl.xml", "totallynotftl.dat"],
      "inputs": [
        "package.json",
        "src/sources.ts",
        "src/document.ts",
        "src/archive.ts",
        "src/generate.ts",
        "../../apps/game/src/game/**/*.ts",
        "!../../apps/game/src/game/**/*.test.ts",
        "../../apps/game/src/i18n/**",
        "../../packages/pack/src/**",
        "../../packages/pack/package.json"
      ]
    },
    "@stl/totallynotftl#test": {
      "inputs": [
        "package.json",
        "src/**",
        "totallynotftl.xml",
        "totallynotftl.dat",
        "../../apps/game/src/game/**/*.ts",
        "!../../apps/game/src/game/**/*.test.ts",
        "../../apps/game/src/i18n/**",
        "../../packages/pack/src/**",
        "../../packages/pack/package.json",
        "../../packages/ftldat/src/**",
        "../../packages/ftldat/package.json"
      ]
    },
    "@stl/campaign#test": {
      "inputs": [
        "package.json",
        "src/**",
        "base.xml",
        "../../apps/game/src/game/**/*.ts",
        "!../../apps/game/src/game/**/*.test.ts",
        "../../packages/pack/src/**",
        "../../packages/pack/package.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "test": {},
    "lint": {}
  }
}
