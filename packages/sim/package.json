    "@stl/hyperspace": "workspace:*",
    "@stl/pack": "workspace:*",
    "@stl/standin": "workspace:*"
  },
  "devDependencies": {
    "@stl/wiki-dump": "workspace:*",
    "@types/node": "^22.16.5",
    "typescript": "^5.7.0"
  }
}
