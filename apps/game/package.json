{
  "name": "@stl/game",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "src/game/pack/base.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build",
    "build:pages": "node scripts/with-app-env.mjs vite build",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "test:src": "node --experimental-strip-types --test src/game/*.test.ts src/game/selftest.ts src/game/extras/*.test.ts src/game/wiki/*.test.ts src/game/pack/*.test.ts",
    "test": "node --test 'scripts/**/*.test.mjs' && pnpm test:src",
    "playthrough": "node scripts/playthrough.mjs",
    "lint": "cd ../.. && ./node_modules/.bin/eslint apps/game"
  },
  "dependencies": {
    "@stl/catalog": "workspace:*",
    "@stl/ftldat": "workspace:*",
    "@stl/hyperspace": "workspace:*",
    "@stl/pack": "workspace:*",
    "@stl/totallynotftl": "workspace:*",
    "@stl/ui": "workspace:*",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@stl/wiki-dump": "workspace:*",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.62.0"
  }
}
