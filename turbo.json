{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@stl/game#build": {
      "dependsOn": ["@stl/campaign#generate", "@stl/totallynotftl#generate", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@stl/campaign#generate": {
      "dependsOn": ["^typecheck"],
      "outputs": ["mod/**", "base.ftl"],
      "inputs": ["package.json", "src/**"]
    },
    "@stl/totallynotftl#generate": {
      "dependsOn": ["@stl/campaign#generate", "^typecheck"],
      "outputs": ["archive/**", "totallynotftl.xml", "totallynotftl.dat"],
      "inputs": [
        "package.json",
        "src/**",
        "tones/**",
        "totallynotftl.dat",
        "$TURBO_ROOT$/apps/game/src/game/gear-look.ts",
        "$TURBO_ROOT$/apps/game/src/game/icons.ts",
        "$TURBO_ROOT$/apps/game/src/game/crew-pixels.ts",
        "$TURBO_ROOT$/apps/game/src/game/pack/base.ts",
        "$TURBO_ROOT$/packages/standin/package.json",
        "$TURBO_ROOT$/packages/standin/src/**"
      ]
    },
    "@stl/totallynotftl#test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["package.json", "src/**", "archive/**", "totallynotftl.xml", "totallynotftl.dat"],
      "env": ["FTL_DAT", "STL_DAT_DIGEST"]
    },
    "@stl/campaign#test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["package.json", "src/**", "mod/**", "base.ftl"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "@stl/game#test:src": {
      "dependsOn": ["^typecheck"],
      "env": ["FTL_DAT", "STL_DATS", "STL_DAT_DIGEST"]
    }
  }
}
