{
  "name": "slower-than-light",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "pnpm --filter @stl/game dev",
    "dev:wiki": "pnpm --filter @stl/wiki dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "wiki:dump": "pnpm --filter @stl/wiki-dump dump",
    "wiki:parity": "pnpm --filter @stl/wiki parity"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.4.0",
    "turbo": "^2.5.8",
    "typescript-eslint": "^8.56.1"
  },
  "pnpm": {
    "overrides": {
      "nf3": "0.3.17"
    }
  }
}
