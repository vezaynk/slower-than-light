    "@stl/ftldat": "workspace:*",
    "@stl/pack": "workspace:*",
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "typescript": "^5.7.0"
  }
}
