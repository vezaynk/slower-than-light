    "@sentry/react": "^11.11.0",
    "@sentry/vite-plugin": "^11.11.0",
    "@stl/ftldat": "workspace:*",
    "@stl/hyperspace": "workspace:*",
    "@stl/pack": "workspace:*",
    "@stl/standin": "workspace:*",
    "@stl/ui": "workspace:*",
