<?xml version="1.0" encoding="UTF-8"?>
<FTL>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_SECTOR_5"/>
    <mod-append:slug>just-getting-started</mod-append:slug>
    <mod-overwrite:condition>
      <value name="sector" min="5"/>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_SECTOR_8"/>
    <mod-append:slug>federation-base-in-range</mod-append:slug>
    <mod-overwrite:condition>
      <value name="sector" min="8"/>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_WIN_EASY"/>
    <mod-append:slug>federation-victory-easy</mod-append:slug>
    <mod-overwrite:condition>
      <value name="victory.easy"/>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_WIN_NORMAL"/>
    <mod-append:slug>federation-victory-normal</mod-append:slug>
    <mod-overwrite:condition>
      <value name="victory.normal"/>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_UNLOCK_ALL"/>
    <mod-append:slug>your-own-fleet</mod-append:slug>
    <mod-overwrite:condition>
      <value name="gauge.typeAUnlocked"/>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_SCRAP"/>
    <mod-append:slug>rule-ten-greed-is-eternal</mod-append:slug>
    <mod-overwrite:condition>
      <value name="lifetime.scrap" min="10000"/>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_SHIPS"/>
    <mod-append:slug>warlord</mod-append:slug>
    <mod-overwrite:condition>
      <value name="lifetime.kills" min="1000"/>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_PACIFIST"/>
    <mod-append:slug>coming-in-for-my-pacifism-run</mod-append:slug>
    <mod-overwrite:condition>
      <value name="sector" min="5"/>
      <not>
        <any>
          <value name="tally.shot"/>
          <value name="tally.offensiveDrone"/>
          <value name="tally.teleported"/>
        </any>
      </not>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_NO_UPGRADES"/>
    <mod-append:slug>i-dont-need-no-stinkin-upgrades</mod-append:slug>
    <mod-overwrite:condition>
      <value name="sector" min="5"/>
      <not>
        <value name="tally.upgraded"/>
      </not>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_NO_REPAIR"/>
    <mod-append:slug>on-a-wing-and-a-prayer</mod-append:slug>
    <mod-overwrite:condition>
      <value name="sector" min="5"/>
      <not>
        <value name="tally.storeRepair"/>
      </not>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_NO_MISSILES"/>
    <mod-append:slug>ballistophobia</mod-append:slug>
    <mod-overwrite:condition>
      <value name="sector" min="8"/>
      <not>
        <value name="tally.missileOrBomb"/>
      </not>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_NO_DRONES"/>
    <mod-append:slug>technophobia</mod-append:slug>
    <mod-overwrite:condition>
      <value name="sector" min="8"/>
      <not>
        <value name="tally.usedDrone"/>
      </not>
    </mod-overwrite:condition>
  </mod:findLike>
  <mod:findLike type="achievement">
    <mod:selector id="ACH_NO_BUYING"/>
    <mod-append:slug>living-off-the-land</mod-append:slug>
    <mod-overwrite:condition>
      <value name="sector" min="8"/>
